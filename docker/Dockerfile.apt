# Ubuntu LTS development image: all C++ dependencies come from Ubuntu APT.
# No compiled GitHub Release assets and no third-party source builds.
FROM ubuntu:24.04

SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ENV DEBIAN_FRONTEND=noninteractive

# GTSAM and Catch2 live in Ubuntu's universe repository; enable it on
# minimal base images without depending on software-properties-common.
RUN set -eux; \
    if ! grep -Eq '^Components:.*(^| )universe( |$)' /etc/apt/sources.list.d/ubuntu.sources; then \
      sed -i '/^Components:/s/$/ universe/' /etc/apt/sources.list.d/ubuntu.sources; \
    fi; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
      ca-certificates build-essential cmake ninja-build pkg-config python3 \
      libeigen3-dev zlib1g-dev libceres-dev libgtsam-dev catch2; \
    for spec in 'libceres-dev:2.2.' 'libgtsam-dev:4.2.' 'catch2:3.4.'; do \
      name="${spec%%:*}"; version="${spec#*:}"; \
      actual="$(dpkg-query -W -f='${Version}' "$name")"; \
      case "$actual" in "$version"*) echo "Verified $name $actual";; \
        *) echo "Unsupported $name $actual (expected $version*)" >&2; exit 1;; \
      esac; \
    done; \
    rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
CMD ["bash"]
