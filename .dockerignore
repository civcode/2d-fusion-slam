# A multi-stage root Dockerfile copies source only into the native build.
.git
.gitignore
.build/
build/
build-*/
cmake-build-*/
Testing/
**/__pycache__/
**/.pytest_cache/
**/*.pyc
*.zip
*.tar.zst
*.tar.gz
*.log
*.slammap
*.mcap
*.bag
*.db3
*.png
*.jpg
*.jpeg
*.webp
.vscode/
.idea/

# Recorded sessions are mounted, never baked into container layers.
*.slamreplay.json
# Never bake recorded scan sessions into image layers.
*.slamreplay.json
